    "/seo/{docId}": {
      "schema": "SEO",
      "description": "SEO and search metadata"
    },
    "/aiSettings/{docId}": {
      "schema": "AISettings",
      "description": "Chatbot AI configurations"
    },
    "/aiKnowledgeBase/{itemId}": {
