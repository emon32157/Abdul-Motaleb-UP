      "description": "About me section content"
    },
    "/skills/{skillId}": {
      "schema": "Skill",
      "description": "Technical skills list"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Professional services list"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Portfolio projects showcase"
    },
    "/experience/{experienceId}": {
      "schema": "Experience",
      "description": "Work history experience entries"
    },
    "/certificates/{certificateId}": {
